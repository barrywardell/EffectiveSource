Cell[CellGroupData[{
Cell["Singular field for a scalar particle in Kerr spacetime", "Title",
 CellChangeTimes->{{3.535378299473462*^9, 3.535378303087487*^9}, {
  3.535820772160522*^9, 3.5358207726605787`*^9}, {3.540902807445409*^9, 
  3.54090280762534*^9}, {3.545116471300514*^9, 3.545116481765422*^9}, {
  3.984127281662137*^9, 
  3.9841272966109247`*^9}},ExpressionUUID->"2f00fcf2-77a7-4271-8bd0-\
826f8b7dbc43"],

Cell["Jonathan Thornburg, Barry Wardell and Samuel Upton", "Subtitle",
 CellChangeTimes->{{3.549109868364356*^9, 3.5491098754891357`*^9}, {
  3.686315750533605*^9, 3.686315753209078*^9}, {3.984127087965332*^9, 
  3.984127092650673*^9}},ExpressionUUID->"c4ad9e05-bcaa-4f89-9fa1-\
9d076ec8cf47"],

Cell[TextData[{
 "This notebook derives the puncture field for a scalar point particle on an \
arbitrary equatorial geodesic in Kerr spacetime. We parametrize the orbits by \
the energy (\[ScriptCapitalE]), angular momentum (\[ScriptCapitalL]), radial \
four-velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox["u", "r"], ")"}], TraditionalForm]],ExpressionUUID->
  "85b32d39-b827-4714-a67b-83a591bbe920"],
 " and radial position ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "r"}], TraditionalForm]],ExpressionUUID->
  "ece1b122-de20-4922-8a3e-c6b3edc26c3a"],
 ").\n\nIf you find this useful in your work, please cite the papers:\n\
\[OpenCurlyDoubleQuote]Scalar self-force for highly eccentric equatorial \
orbits in Kerr spacetime\[CloseCurlyDoubleQuote], Jonathan Thornburg and \
Barry Wardell (2016)\n\[OpenCurlyDoubleQuote]Self-force calculations with \
numerical relativity methods\[CloseCurlyDoubleQuote], Nils L. Vu, Nami \
Nishimura, Thomas Osburn, Jonathan E. Thompson, Lawrence E. Kidder, Samuel D. \
Upton and Barry Wardell\n"
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBWIQfcZjVX9ewSvHW/Xe00H01Ec1MfGFrxwPf86LBdFH
fAu4EoD0sp5OHhC9TvOKLojOdte1BdEp3+f1JgLpkoMsc0H0n/8LVyYB6Us6
